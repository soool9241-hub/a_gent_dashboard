{
  "name": "WF-04 자동 팔로업 너처링 시퀀스",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }]
        }
      },
      "id": "cron-9am",
      "name": "매일 09:00 실행",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// 오늘 팔로업 대상 조회 쿼리 생성\nconst today = new Date().toISOString().split('T')[0];\nreturn [{ json: { today } }];"
      },
      "id": "get-today",
      "name": "오늘 날짜",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "url": "={{$env.SUPABASE_URL}}/rest/v1/leads?next_action_date=lte.{{$json.today}}&stage=in.(cold,warm,hot)&select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-nurture-targets",
      "name": "팔로업 대상 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json);\nconst flatLeads = Array.isArray(leads[0]) ? leads[0] : leads;\n\n// 각 리드에 대해 다음 시퀀스 메시지 준비\nconst actions = flatLeads.map(lead => {\n  const step = lead.nurture_step || 0;\n  const delays = [0, 1, 3, 5, 7, 14, 30];\n  const nextDelay = delays[Math.min(step + 1, delays.length - 1)];\n  const nextDate = new Date();\n  nextDate.setDate(nextDate.getDate() + nextDelay);\n\n  return {\n    json: {\n      lead_id: lead.id,\n      name: lead.name,\n      phone: lead.phone,\n      email: lead.email,\n      business_unit: lead.business_unit,\n      current_step: step,\n      next_step: step + 1,\n      next_action_date: nextDate.toISOString().split('T')[0],\n      message: `[팔로업 Step ${step}] ${lead.name}님 자동 메시지 발송 예정`\n    }\n  };\n});\n\nreturn actions.length > 0 ? actions : [{ json: { message: '오늘 팔로업 대상 없음', count: 0 } }];"
      },
      "id": "prepare-messages",
      "name": "메시지 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "url": "={{$env.SUPABASE_URL}}/rest/v1/leads?id=eq.{{$json.lead_id}}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"nurture_step\": {{$json.next_step}},\n  \"next_action_date\": \"{{$json.next_action_date}}\",\n  \"last_contact_date\": \"{{new Date().toISOString().split('T')[0]}}\",\n  \"contact_count\": {{($json.contact_count || 0) + 1}}\n}",
        "options": {}
      },
      "id": "update-lead-step",
      "name": "리드 스텝 업데이트",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=📬 **너처링 시퀀스 실행 완료**\n\n{{$json.message}}\n⏰ 다음 팔로업: {{$json.next_action_date}}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-nurture",
      "name": "텔레그램 알림",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 480]
    }
  ],
  "connections": {
    "매일 09:00 실행": {
      "main": [[{ "node": "오늘 날짜", "type": "main", "index": 0 }]]
    },
    "오늘 날짜": {
      "main": [[{ "node": "팔로업 대상 조회", "type": "main", "index": 0 }]]
    },
    "팔로업 대상 조회": {
      "main": [[{ "node": "메시지 준비", "type": "main", "index": 0 }]]
    },
    "메시지 준비": {
      "main": [[
        { "node": "리드 스텝 업데이트", "type": "main", "index": 0 },
        { "node": "텔레그램 알림", "type": "main", "index": 0 }
      ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "너처링" }]
}
